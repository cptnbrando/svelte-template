{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__APP_TITLE__",
  "version": "1.0.0",
  "identifier": "__APP_ID__",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "__APP_TITLE__", "width": 1200, "height": 800, "minWidth": 320, "minHeight": 320 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
